# Copy to .env and fill in. NEVER commit a real .env.
ENVIRONMENT=local
BUILD_VERSION=0.1.0
SERVICE_NAME=shipment-delay-agent

# Provider switch: openai | anthropic | gemini | azure_openai | mock
#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=nemotron
LLM_TEMPERATURE=0.2
LLM_BASE_URL=https://glass.client-poc.tx1client0.com/agent/gids-corp/test-router/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization

LLM_MODEL=azure-inference/DeepSeek-V4-Pro
LLM_MODEL_NOTIFICATION=nemotron-nano-8b
#LLM_MODEL=nemotron-omni-30b-a3b-fp8      # fallback for anything unset
LLM_MODEL_MITIGATION=nemotron-super-49b
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Reasoning models emit a <think> trace. Keep true unless the server already runs
# a reasoning parser (vLLM: --reasoning-parser nemotron_v3); with no parser the
# trace lands in message.content and breaks JSON parsing.
LLM_STRIP_REASONING=true
# Set false if the gateway does not implement response_format={"type":"json_object"};
# structured output then falls back to prompt-instructed JSON plus tolerant parsing.
LLM_USE_JSON_MODE=true

# Secrets (leave blank to use the mock provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Analytics thresholds
SUPPORT_FLOOR=200
EFFECT_SIZE_MIN=0.15
FDR_Q=0.05
CONFOUND_MARGIN=0.15
STABILITY_VAR_MAX=0.30
ESCALATION_CONFIDENCE=0.75
SHRINKAGE_K=50
ETA_PERCENTILE=75

# Security
JWT_SECRET=change-me-in-prod
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=50

# Reliability
REQUIRE_HUMAN_REVIEW=true
ENABLE_LLM_NOTIFICATIONS=true

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
MAX_UPLOAD_MB=200
TRIAGE_QUEUE_CAP=0

# Top-ranked findings that may escalate per run. Each must clear
# ESCALATION_CONFIDENCE on its own, so a weak second finding is omitted rather
# than padded in. The Overview panel shows up to 2.
MAX_ESCALATIONS=2

# ---------------------------------------------------------------------------
# File-drop trigger
# ---------------------------------------------------------------------------
# Directory watched for dropped batches (.csv/.xlsx/.xls). BLANK DISABLES the
# watcher, so tests and CLI runs never spawn a background scan. Set it and the
# watcher starts automatically with the API.
TRIGGER_INBOX_DIR=./data/input
# Processed files are MOVED here; failures go to <archive>/failed/ so a bad file
# is kept for inspection instead of being retried on every poll. Moving the file
# out of the inbox is what makes the watcher restart-safe.
TRIGGER_ARCHIVE_DIR=./data/archive
TRIGGER_POLL_S=5
# Consecutive polls a file's size must stay unchanged before it is read, so a
# large copy still in progress is not parsed half-written. Minimum 2.
TRIGGER_STABLE_POLLS=2