# Copy to .env and fill in. NEVER commit a real .env.
ENVIRONMENT=local
BUILD_VERSION=0.1.0

# Provider switch: openai | anthropic | gemini | azure_openai | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Secrets (leave blank to use the mock provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Analytics thresholds
SUPPORT_FLOOR=200
EFFECT_SIZE_MIN=0.15
FDR_Q=0.05
CONFOUND_MARGIN=0.15
STABILITY_VAR_MAX=0.30
ESCALATION_CONFIDENCE=0.75

# Security
JWT_SECRET=change-me-in-prod
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=50

# Reliability
REQUIRE_HUMAN_REVIEW=true
ENABLE_LLM_NOTIFICATIONS=true

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
